#ifndef SECRETS_H
#define SECRETS_H

#include "StdInc.h"

// Generated by CMake into the build directory from environment variables. Do not edit manually
// and do not commit to the repository.
//
// The material is interleaved into 4 shards character/byte by character/byte, so the binary
// contains neither printable ciphertext fragments nor the original mask: the ciphertext shards
// hold base64 alphabet indices (the padding character '=' is encoded as 64) and the mask shards
// hold XOR-obfuscated values, each with a key randomized per build directory.
// See lib/filesystem/protect/SecretConstants.cpp for the reconstruction logic.
VCMI_LIB_NAMESPACE_BEGIN

namespace ModPassword
{
namespace Secrets
{

constexpr unsigned char cipherShard0[] = { @CIPHER_SHARD_0_STR@ };
constexpr unsigned char cipherShard1[] = { @CIPHER_SHARD_1_STR@ };
constexpr unsigned char cipherShard2[] = { @CIPHER_SHARD_2_STR@ };
constexpr unsigned char cipherShard3[] = { @CIPHER_SHARD_3_STR@ };
constexpr unsigned char cipherShardKeys[] = { @CIPHER_SHARD_KEYS_STR@ };
constexpr unsigned int cipherShardCount = @SHARD_COUNT@;
constexpr unsigned int cipherLength = @CIPHER_LENGTH@;

constexpr unsigned char maskShard0[] = { @MASK_SHARD_0_STR@ };
constexpr unsigned char maskShard1[] = { @MASK_SHARD_1_STR@ };
constexpr unsigned char maskShard2[] = { @MASK_SHARD_2_STR@ };
constexpr unsigned char maskShard3[] = { @MASK_SHARD_3_STR@ };
constexpr unsigned char maskShardKeys[] = { @MASK_SHARD_KEYS_STR@ };
constexpr unsigned int maskShardCount = @SHARD_COUNT@;
constexpr unsigned int maskLength = @MASK_BYTE_COUNT@;

}
}

VCMI_LIB_NAMESPACE_END

#endif // SECRETS_H
