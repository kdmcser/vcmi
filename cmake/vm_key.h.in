#ifndef VM_KEY_H
#define VM_KEY_H

#include "StdInc.h"

// 由 CMake 在首次配置时随机生成，同一个构建目录固定一份。
//
// 作用：让字节码里"物理 opcode"与"逻辑指令"的对应关系不落在源码里 ——
// 同一个逻辑指令在不同构建产物里对应不同的字节值，想还原必须读懂
// lib/filesystem/protect/VmAsm.h 里的置换逻辑。
VCMI_LIB_NAMESPACE_BEGIN

namespace ModPassword
{
namespace Vm
{

constexpr std::uint8_t vmOpcodeKey0 = 0x@VM_KEY_0@;
constexpr std::uint8_t vmOpcodeKey1 = 0x@VM_KEY_1@;
constexpr std::uint8_t vmOpcodeXorMask = 0x@VM_KEY_X@;

}
}

VCMI_LIB_NAMESPACE_END

#endif // VM_KEY_H
