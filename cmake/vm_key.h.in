#ifndef VM_KEY_H
#define VM_KEY_H

#include "StdInc.h"

// Randomly generated by CMake on first configure; fixed for the lifetime of a build directory.
//
// Purpose: keep the correspondence between the "physical opcodes" in the bytecode and the
// "logical instructions" out of the source tree -- the same logical instruction maps to a
// different byte value in every build, so reconstructing it requires understanding the
// permutation logic in lib/filesystem/protect/VmAsm.h.
VCMI_LIB_NAMESPACE_BEGIN

namespace ModPassword
{
namespace Vm
{

constexpr std::uint8_t vmOpcodeKey0 = 0x@VM_KEY_0@;
constexpr std::uint8_t vmOpcodeKey1 = 0x@VM_KEY_1@;
constexpr std::uint8_t vmOpcodeXorMask = 0x@VM_KEY_X@;

}
}

VCMI_LIB_NAMESPACE_END

#endif // VM_KEY_H
